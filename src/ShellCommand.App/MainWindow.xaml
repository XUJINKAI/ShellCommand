<Window x:Class="ShellCommand.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ShellCommand 11" Width="760" Height="480" MinWidth="600" MinHeight="360">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock FontSize="26" FontWeight="SemiBold">ShellCommand 11</TextBlock>
    <TabControl Grid.Row="1" Margin="0,20,0,20">
      <TabItem Header="My Commands"><StackPanel Margin="16">
        <TextBlock FontSize="18" FontWeight="SemiBold">Runtime status</TextBlock>
        <TextBlock Margin="0,12,0,0" Text="Broker: configured for the current user" />
        <TextBlock Text="Explorer integration: verify with the development install script" />
        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Text="Global config: %LOCALAPPDATA%\ShellCommand11\config\global.shellcommand.yaml" />
        <WrapPanel Margin="0,20,0,0"><Button Margin="0,0,8,0" Padding="12,6" Content="Open Global Config" Click="OpenGlobalConfig_Click"/><Button Padding="12,6" Content="Open Config Folder" Click="OpenConfigFolder_Click"/></WrapPanel>
      </StackPanel></TabItem>
      <TabItem Header="Context Menu Manager"><TextBlock Margin="16" TextWrapping="Wrap" Text="Discovery and reversible menu management are available through the Broker service boundary. System and unsupported entries are read-only by design."/></TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Foreground="Gray" Text="ShellCommand 11.0.0" />
  </Grid>
</Window>
