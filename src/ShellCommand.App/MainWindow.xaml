<Window x:Class="ShellCommand.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShellCommand 11"
        Width="760" Height="520" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock FontSize="28" FontWeight="SemiBold">ShellCommand 11</TextBlock>
    <TextBlock Grid.Row="1" Margin="0,6,0,22" Foreground="#666666" Text="让常用命令出现在 Windows 11 右键菜单中" />

    <Border Grid.Row="2" Padding="20" Background="#F5F7FA" CornerRadius="10" BorderBrush="#E1E5EA" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
          <TextBlock x:Name="StatusTitle" FontSize="21" FontWeight="SemiBold" DockPanel.Dock="Left" />
          <Button Content="刷新状态" Padding="12,5" Click="Refresh_Click" DockPanel.Dock="Right" />
        </DockPanel>
        <TextBlock x:Name="StatusMessage" Grid.Row="1" Margin="0,8,0,18" Foreground="#555555" TextWrapping="Wrap" />

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Windows 右键菜单" Foreground="#666666" Margin="0,0,0,10" />
          <TextBlock x:Name="PackageStatus" Grid.Column="1" Margin="0,0,0,10" />
          <TextBlock Text="后台服务" Grid.Row="1" Foreground="#666666" Margin="0,0,0,10" />
          <TextBlock x:Name="BrokerStatus" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" />
          <TextBlock Text="开机启动" Grid.Row="2" Foreground="#666666" Margin="0,0,0,10" />
          <TextBlock x:Name="AutoStartStatus" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" />
          <TextBlock Text="程序文件" Grid.Row="3" Foreground="#666666" />
          <TextBlock x:Name="FilesStatus" Grid.Row="3" Grid.Column="1" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,22,0,0">
          <Button x:Name="InstallButton" Content="安装 / 修复" Padding="18,8" Click="Install_Click" />
          <Button x:Name="UninstallButton" Content="卸载" Padding="18,8" Margin="10,0,0,0" Click="Uninstall_Click" />
          <Button x:Name="RestartButton" Content="重启 Explorer" Padding="18,8" Margin="10,0,0,0" Click="RestartExplorer_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button Content="打开全局配置" Padding="12,6" Click="OpenGlobalConfig_Click" />
        <Button Content="打开配置目录" Padding="12,6" Margin="8,0,0,0" Click="OpenConfigFolder_Click" />
      </StackPanel>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#888888" Text="ShellCommand 11.0.0" />
    </Grid>
  </Grid>
</Window>
